# Copy to ~/.config/agent-host/dev.env and replace placeholders locally.
# Container env-file syntax: KEY=value, without export or shell quoting.
# Use development-scoped credentials only. Omit variables a task does not need.

# Terraform's development Proxmox identity.
TF_VAR_virtual_environment_endpoint=https://pve.example.invalid:8006/
TF_VAR_virtual_environment_api_token=REPLACE_WITH_DEV_TERRAFORM_API_TOKEN

# Ansible's development Proxmox inventory identity (separate from Terraform).
PROXMOX_URL=https://pve.example.invalid:8006/
PROXMOX_USER=REPLACE_WITH_DEV_INVENTORY_USER
PROXMOX_TOKEN_ID=ci
PROXMOX_TOKEN_SECRET=REPLACE_WITH_DEV_INVENTORY_TOKEN_SECRET

# Development Terraform state access; use temporary AWS credentials when available.
AWS_ACCESS_KEY_ID=REPLACE_WITH_DEV_STATE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_DEV_STATE_SECRET_KEY
# AWS_SESSION_TOKEN=REPLACE_IF_USING_TEMPORARY_CREDENTIALS
AWS_DEFAULT_REGION=ap-southeast-2
TF_CLI_ARGS_init=-backend-config=bucket=REPLACE_WITH_STATE_BUCKET -backend-config=region=ap-southeast-2

# Include only when the task needs development DNS changes for Vault.
# CLOUDFLARE_API_TOKEN=REPLACE_WITH_DEV_DNS_TOKEN

# Optional: mount a dedicated directory using --credentials-dir.
# ANSIBLE_PRIVATE_KEY_FILE=/run/credentials/ansible-ci

# Optional: short-lived installation token for the separate agent GitHub App.
# GH_TOKEN=REPLACE_WITH_REPOSITORY_SCOPED_INSTALLATION_TOKEN
