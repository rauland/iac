{
  "Statement": [
    {
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab"
      ],
      "Sid": "ListBackendMetadata"
    },
    {
      "Action": [
        "s3:GetObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/dev/*.tfstate"
      ],
      "Sid": "ReadOwnState"
    },
    {
      "Action": [
        "s3:GetObject*",
        "s3:PutObject*",
        "s3:DeleteObject*"
      ],
      "Effect": "Deny",
      "NotResource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/dev/*.tfstate",
        "arn:aws:s3:::rauland-iac-homelab/terraform/dev/*.tfstate.tflock"
      ],
      "Sid": "DenyObjectsOutsideOwnState"
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/dev/*.tfstate"
      ],
      "Sid": "WriteOwnState"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/dev/*.tfstate.tflock"
      ],
      "Sid": "ManageOwnLocks"
    }
  ],
  "Version": "2012-10-17"
}
