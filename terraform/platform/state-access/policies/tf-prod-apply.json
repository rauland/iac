{
  "Statement": [
    {
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab"
      ],
      "Sid": "ListBackendMetadata"
    },
    {
      "Action": [
        "s3:GetObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/prod/*.tfstate"
      ],
      "Sid": "ReadOwnState"
    },
    {
      "Action": [
        "s3:GetObject*",
        "s3:PutObject*",
        "s3:DeleteObject*"
      ],
      "Effect": "Deny",
      "NotResource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/prod/*.tfstate",
        "arn:aws:s3:::rauland-iac-homelab/terraform/prod/*.tfstate.tflock"
      ],
      "Sid": "DenyObjectsOutsideOwnState"
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/prod/*.tfstate"
      ],
      "Sid": "WriteOwnState"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::rauland-iac-homelab/terraform/prod/*.tfstate.tflock"
      ],
      "Sid": "ManageOwnLocks"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/shared/proxmox",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/shared/proxmox/*",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/shared/wireguard",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/shared/wireguard/*",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/prod/apply",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/prod/apply/*",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/shared/apply",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/shared/apply/*",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/prod/ansible",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/prod/ansible/*",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/prod/flux",
        "arn:aws:ssm:ap-southeast-2:*:parameter/iac/prod/flux/*"
      ],
      "Sid": "ReadOwnParameters"
    }
  ],
  "Version": "2012-10-17"
}
