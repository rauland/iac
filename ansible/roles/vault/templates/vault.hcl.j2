api_addr = "https://{{ vault_api_addr }}:8200"
cluster_addr = "https://{{ vault_cluster_addr }}:8201"

storage "file" {
  path = "/opt/vault/data"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  tls_cert_file   = "/etc/vault.d/ssl/tls.crt"
  tls_key_file    = "/etc/vault.d/ssl/tls.key"
}

ui             = true
disable_cache  = true
disable_mlock  = false
