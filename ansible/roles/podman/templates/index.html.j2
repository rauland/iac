<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ podman_nginx_site_title | e }}</title>
    <style>
      body { margin: 0; font: 1.1rem system-ui, sans-serif; color: #e2e8f0; background: #0f172a; }
      main { max-width: 42rem; margin: 18vh auto; padding: 2rem; }
      h1 { font-size: clamp(2rem, 6vw, 3.5rem); letter-spacing: -0.04em; }
      .status { color: #86efac; }
      p { line-height: 1.7; }
    </style>
  </head>
  <body>
    <main data-service="podman-nginx">
      <p class="status">Site online</p>
      <h1>{{ podman_nginx_site_title | e }}</h1>
      <p>This site is served by Nginx running in a Podman container.</p>
    </main>
  </body>
</html>
